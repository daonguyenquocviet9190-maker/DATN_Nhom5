APP_NAME="Dynova Sport API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / XAMPP / phpMyAdmin
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dynova_sport
DB_USERNAME=root
DB_PASSWORD=

# Local development: không yêu cầu bảng sessions/cache/jobs
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Dynova Sport"

FRONTEND_URL=http://localhost:3000

GHN_ENV=staging
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_PRODUCTION_ENABLED=false
GHN_TOKEN=
GHN_SHOP_ID=
GHN_CLIENT_ID=
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
GHN_SERVICE_TYPE_ID=2
GHN_PAYMENT_TYPE_ID=1
GHN_REQUIRED_NOTE=CHOXEMHANGKHONGTHU
GHN_DEFAULT_ITEM_WEIGHT=300
GHN_DEFAULT_LENGTH=20
GHN_DEFAULT_WIDTH=15
GHN_DEFAULT_HEIGHT=10
GHN_MAX_INSURANCE_VALUE=500000
GHN_TIMEOUT=30
GHN_CONNECT_TIMEOUT=10
GHN_VERIFY_SSL=true
GHN_WEBHOOK_SECRET=
GHN_SIMULATION_AUTO_START=true
GHN_SIMULATION_DURATION_SECONDS=240
GHN_SIMULATION_SPEED=1


VIETQR_ENV=demo
VIETQR_IMAGE_BASE_URL=https://img.vietqr.io/image

# DATN DEMO SAFE: scan QR -> simulated paid, no real bank transfer
VIETQR_DEMO_SCAN_ENABLED=true
# Optional. Leave blank to let Laravel try the PC LAN IP automatically.
# If phone cannot open the QR, set this to your PC IPv4, e.g. http://192.168.1.10:8000
VIETQR_DEMO_SCAN_BASE_URL=
VIETQR_DEMO_QR_IMAGE_URL=https://quickchart.io/qr
# Optional. If blank, APP_KEY is used to sign each QR token.
VIETQR_DEMO_SCAN_SECRET=

# Future real-provider webhook only
VIETQR_WEBHOOK_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:8000/api/payments/vnpay/return
